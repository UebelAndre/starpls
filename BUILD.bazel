load("@rules_rust//rust:defs.bzl", "rust_library_group")
load("@rules_rust_prost//:defs.bzl", "rust_prost_toolchain")
load(":wasm_binary.bzl", "wasm_binary")

exports_files(["rustfmt.toml"])

rust_library_group(
    name = "prost_runtime",
    deps = [
        "@crates//:prost",
    ],
)

# starpls uses prost messages only. No tonic: a tonic runtime pulls in
# networking crates (socket2) that do not build for WebAssembly.
rust_prost_toolchain(
    name = "prost_toolchain_impl",
    prost_plugin = "@crates//:protoc-gen-prost__protoc-gen-prost",
    prost_runtime = ":prost_runtime",
    prost_types = "@crates//:prost-types",
    # The flag has a non-empty default; clear it so the rule sees no tonic at all.
    tonic_plugin_flag = "",
)

toolchain(
    name = "prost_toolchain",
    toolchain = "prost_toolchain_impl",
    toolchain_type = "@rules_rust_prost//:toolchain_type",
)

# The server for WebAssembly hosts (WASI preview 1), e.g. the VS Code
# WebAssembly runtime. `bazel build //:starpls_wasm` builds it without
# `--platforms`; the binary runs single-threaded, see crates/starpls/src/single_thread.rs.
platform(
    name = "wasm32-wasip1",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
)

wasm_binary(
    name = "starpls_wasm",
    binary = "//crates/starpls",
    platform = ":wasm32-wasip1",
    visibility = ["//visibility:public"],
)
